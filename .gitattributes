# Keep vendored libraries and OCR assets byte-identical across platforms
*.min.js                 -text -diff linguist-vendored
tesseract-core-*.wasm.js -text -diff linguist-vendored
*.wasm                   binary
*.traineddata.gz         binary
*.gz                     binary

# Normalise line endings for everything we actually author
*.html  text eol=lf
*.md    text eol=lf
